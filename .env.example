# Copy to .env. Without a key the app runs in mock mode only.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# Optional. Leave blank: newer models reject it.
TEMPERATURE=
PORT=5173

# Optional settings. Everything below is commented out on purpose; the defaults are the safe ones.
# Default is 127.0.0.1 (this computer only). A network address makes the server reachable and requires STEBULA_TOKEN.
# HOST=
# STEBULA_TOKEN=
# 1 = public replay only (no live calls, no stored conversations)
# STEBULA_PUBLIC=
# Cap on model calls for one live experiment run (default 120)
# LIVE_MAX_CALLS=
# Folder for memory, records and experiments (default data/)
# STEBULA_DATA=
# Model request timeout in milliseconds (default 90000)
# REQUEST_TIMEOUT_MS=
# Retries for transient provider errors (default 2)
# MAX_RETRIES=
